LIVEKIT_URL=wss://livekit.openz.top:7443
LIVEKIT_API_KEY=openz
LIVEKIT_API_SECRET=35b58a62c4a6f5a188c8537999e0524dbb0b697085fc3660bf9564d5dc083ce6
AGENT_NAME=openz


PIPELINE=pipeline

# ---------------------------------------------------------------------------
# Bridge server — LiveKit openai.LLM → 本地 :8765 → Hermes api_server :8642
# ---------------------------------------------------------------------------
# scripts/bridge_server.py 监听 BRIDGE_BASE_URL（默认 8765），把 OpenAI 兼容
# /v1/chat/completions 透传到 HERMES_API_BASE。LiveKit 端 openai.LLM 指向 bridge，
# bridge 把 X-LiveKit-Room/User 透到 Hermes。
#
# 启动：
#   bash scripts/start_bridge.sh          # 起 bridge
#   API_SERVER_ENABLED=true API_SERVER_KEY=$BRIDGE_API_KEY API_SERVER_PORT=8642 hermes gateway run
BRIDGE_BASE_URL=http://127.0.0.1:8765/v1
BRIDGE_API_KEY=bridge
BRIDGE_MODEL=hermes-agent
LIVEKIT_ROOM_NAME=demo

# bridge 内部转发 — 由 bridge_server.py 使用，不要直接给 LiveKit 端读
HERMES_API_BASE=http://127.0.0.1:8642/v1
HERMES_API_KEY=livekit-bridge-test
