# ---------------------------------------------------------------------------
# Hermes API Server — openai.LLM base_url / api_key / model
# ---------------------------------------------------------------------------
# Hermes gateway 自带 OpenAI 兼容 api_server（gateway/platforms/api_server.py），
# LiveKit 端用 openai.LLM 指过去即可，无需本地 bridge。
# 启动方式：API_SERVER_ENABLED=true API_SERVER_KEY=<key> API_SERVER_PORT=8642 hermes gateway run
HERMES_BRIDGE_BASE_URL=http://127.0.0.1:8642/v1
HERMES_BRIDGE_API_KEY=dev-test-key
HERMES_BRIDGE_MODEL=hermes-agent
