#!/usr/bin/env bash
# scripts/openvox — 仓库内 dev-mode 启动器
#
# 探测 venv 后用 `python -m openvox_worker` 跑 CLI。装完包后应直接
# 用 `openvox ...`（由 pyproject.toml 的 [project.scripts] 注入）。
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
REPO_ROOT="$(cd "${APP_DIR}/../.." && pwd)"

PYTHON=""
for candidate in \
    "${APP_DIR}/.venv/bin/python" \
    "${REPO_ROOT}/.venv/bin/python"; do
    if [[ -x "${candidate}" ]]; then
        PYTHON="${candidate}"
        break
    fi
done
if [[ -z "${PYTHON}" ]]; then
    PYTHON="python3"
fi

exec "${PYTHON}" -m openvox_worker "$@"
