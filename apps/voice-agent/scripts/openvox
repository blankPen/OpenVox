#!/usr/bin/env bash
# Thin launcher for the unified openvox CLI.
#
# Prefers the repository virtualenv interpreter (.venv/bin/python) so the
# LiveKit / Volcengine dependency stack is on sys.path; falls back to python3.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
REPO_ROOT="$(cd "${APP_DIR}/../.." && pwd)"

PYTHON=""
for candidate in \
    "${APP_DIR}/.venv/bin/python" \
    "${REPO_ROOT}/.venv/bin/python"; do
    if [[ -x "${candidate}" ]]; then
        PYTHON="${candidate}"
        break
    fi
done
if [[ -z "${PYTHON}" ]]; then
    PYTHON="python3"
fi

exec "${PYTHON}" "${APP_DIR}/openvox_cli.py" "$@"
