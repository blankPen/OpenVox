# OpenVox — 跨端环境变量示例
# 复制为各 app 内的 .env 后填值

# LiveKit Server
LIVEKIT_URL=wss://livekit.openz.top:7443
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Agent
AGENT_NAME=openvox

# Volcengine 凭证（仅后端用，前端不该有）
# 后端从 ~/.openvox/config.json 读，留作参考
VOLCENGINE_APP_ID=
VOLCENGINE_ACCESS_TOKEN=
VOLCENGINE_STT_CLUSTER=
VOLCENGINE_TTS_CLUSTER=
VOLCENGINE_TTS_VOICE=zh_female_shuangjing

# 客户端 Sandbox Token（仅开发用）
# 生产参考 shared/livekit-claims.example.json，由自建 token 服务签发
LIVEKIT_SANDBOX_ID=
